// Prisma Schema for Dairy Farm Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

// Animal Records
model Animal {
  id            String       @id @default(cuid())
  tagNumber     String       @unique
  breed         String
  gender        Gender
  dateOfBirth   DateTime
  purchaseDate  DateTime?
  purchasePrice Float?
  status        AnimalStatus @default(ACTIVE)
  currentWeight Float?
  origin        String?
  color         String?
  notes         String?      @db.Text
  imageUrl      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  healthRecords   AnimalHealth[]
  weightRecords   AnimalWeight[]
  breedingRecords BreedingMale[]
  breedingFemale  BreedingFemale[]
  milkRecords     MilkRecord[]

  @@map("animals")
}

enum Gender {
  MALE
  FEMALE
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DECEASED
  TRANSFERRED
}

// Animal Health Records
model AnimalHealth {
  id                String       @id @default(cuid())
  animalId          String
  animal            Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
  dateOfExamination DateTime
  disease           String
  symptoms          String?      @db.Text
  treatment         String?      @db.Text
  medication        String?
  veterinarian      String?
  cost              Float?
  nextCheckupDate   DateTime?
  status            HealthStatus @default(UNDER_TREATMENT)
  notes             String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([animalId])
  @@map("animal_health")
}

enum HealthStatus {
  HEALTHY
  UNDER_TREATMENT
  CRITICAL
  RECOVERED
}

// Animal Weight Records
model AnimalWeight {
  id             String   @id @default(cuid())
  animalId       String
  animal         Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  dateOfWeighing DateTime
  weight         Float
  height         Float?
  bodyCondition  String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([animalId])
  @@map("animal_weight")
}

// Breeding Records
model Breeding {
  id                String          @id @default(cuid())
  dateOfBreeding    DateTime
  expectedDelivery  DateTime?
  actualDelivery    DateTime?
  breedingMethod    BreedingMethod
  outcome           BreedingOutcome @default(PENDING)
  numberOfOffspring Int?
  notes             String?         @db.Text
  cost              Float?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  maleAnimals   BreedingMale[]
  femaleAnimals BreedingFemale[]

  @@map("breeding")
}

model BreedingMale {
  id         String   @id @default(cuid())
  breedingId String
  animalId   String
  breeding   Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([breedingId])
  @@index([animalId])
  @@map("breeding_male")
}

model BreedingFemale {
  id         String   @id @default(cuid())
  breedingId String
  animalId   String
  breeding   Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([breedingId])
  @@index([animalId])
  @@map("breeding_female")
}

enum BreedingMethod {
  NATURAL
  ARTIFICIAL_INSEMINATION
}

enum BreedingOutcome {
  PENDING
  SUCCESSFUL
  FAILED
  ABORTED
}

// Milk Production Records
model MilkRecord {
  id             String      @id @default(cuid())
  animalId       String
  animal         Animal      @relation(fields: [animalId], references: [id], onDelete: Cascade)
  date           DateTime
  morningYield   Float?
  afternoonYield Float?
  eveningYield   Float?
  totalYield     Float
  quality        MilkQuality @default(GOOD)
  fatContent     Float?
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())

  @@index([animalId])
  @@index([date])
  @@map("milk_records")
}

enum MilkQuality {
  EXCELLENT
  GOOD
  AVERAGE
  POOR
}

// Customer Management
model Customer {
  id                   String    @id @default(cuid())
  name                 String
  phone                String?
  email                String?
  address              String?   @db.Text
  defaultPricePerLiter Float?
  lastPurchaseDate     DateTime?
  totalPurchases       Float     @default(0)
  balance              Float     @default(0) // Positive = advance/credit, Negative = due/pending
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  milkSales MilkSale[]

  @@index([name])
  @@map("customers")
}

// Milk Sales Records
model MilkSale {
  id            String        @id @default(cuid())
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  saleDate      DateTime
  quantity      Float
  pricePerLiter Float
  totalAmount   Float
  amountPaid    Float         @default(0) // Amount actually paid by customer
  buyer         String?
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([saleDate])
  @@index([customerId])
  @@map("milk_sales")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

// Stock Feed Management
model StockFeed {
  id           String    @id @default(cuid())
  feedName     String
  feedType     FeedType
  quantity     Float
  unit         String    @default("kg")
  purchaseDate DateTime
  expiryDate   DateTime?
  supplier     String?
  costPerUnit  Float
  totalCost    Float
  minimumStock Float?
  currentStock Float
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([feedName])
  @@map("stock_feed")
}

enum FeedType {
  CONCENTRATE
  ROUGHAGE
  MINERAL_SUPPLEMENT
  VITAMIN_SUPPLEMENT
  OTHER
}

// Employee Management
model Employee {
  id            String         @id @default(cuid())
  employeeId    String         @unique
  name          String
  position      String
  department    String?
  phone         String?
  email         String?
  address       String?        @db.Text
  dateOfJoining DateTime
  dateOfLeaving DateTime?
  salary        Float
  status        EmployeeStatus @default(ACTIVE)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  RESIGNED
}

// Farm Finance Management
model Finance {
  id              String      @id @default(cuid())
  date            DateTime
  type            FinanceType
  category        String
  description     String      @db.Text
  amount          Float
  paymentMethod   String?
  referenceNumber String?
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([date])
  @@index([type])
  @@map("finance")
}

enum FinanceType {
  INCOME
  EXPENSE
}
